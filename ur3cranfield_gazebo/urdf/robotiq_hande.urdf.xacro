<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="robotiq_hande" params="bringup" >

    <!-- ======================= -->
    <!-- PART 1: LINK+JOINT TREE -->
    <!-- ======================= -->
    
    <!-- Robotiq: coupler -->
    <link name="robotiq_coupler">
      <visual>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/robotiq_hande_coupler.stl" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/robotiq_hande_coupler.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="2.073e-05   1.45286e-03  -1.1049e-03" rpy="0 0 0" />
        <mass value="0.25" />
        <inertia ixx="6.69695624e-05" ixy="5.21511788e-09" ixz="-2.74383009e-08" 
                iyy="7.85088161e-05" iyz="5.41105193e-07" izz="1.41819717e-04"/>
      </inertial>
    </link>

    <joint name="robotiq_coupler_joint" type="fixed">
      <origin xyz="0 0 -0.009" rpy="0 0 ${-pi/2.0}" />
      <parent link="tool0"/>
      <child link="robotiq_coupler"/>
    </joint>

    <gazebo reference="robotiq_coupler">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
      <material>Gazebo/FlatBlack</material>
    </gazebo>

    <!-- Robotiq: base_link -->
    <link name="robotiq_hande_base_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/hand-e.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/hand-e.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.86387" />
        <origin xyz="0.0 0.0 0.0" />
        <inertia ixx="1017560E-9" ixy="0" ixz="2235E-9" iyy="1028041E-9" iyz="0" izz="489810E-9"/>
      </inertial>
    </link>

    <gazebo reference="robotiq_hande_base_link">
      <material>Gazebo/FlatBlack</material>
    </gazebo>

    <joint name="robotiq_hande_base_joint" type="fixed">
      <origin xyz="0 0 -0.003" rpy="0 0.0 0.0"/>
      <parent link="robotiq_coupler"/>
      <child link="robotiq_hande_base_link"/>
    </joint>

    <!-- Robotiq: left finger -->
    <link name="robotiq_hande_left_finger">
      <inertial>
        <origin rpy="0 0 0" xyz="0.02262 -0.00759 0.00738"/>
        <mass value="0.03804"/>
        <inertia ixx="13567E-9" ixy="1849E-9" ixz="3622E-9" iyy="15784E-9" iyz="3616E-9" izz="7478E-9"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/finger_1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/finger_1.dae"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="robotiq_hande_left_finger">
      <material>Gazebo/Grey</material>
    </gazebo>

    <joint name="robotiq_hande_left_finger_joint" type="prismatic">
      <origin rpy="0 0 0" xyz="0.0 0.0 0.099"/>
      <parent link="robotiq_hande_base_link"/>
      <child link="robotiq_hande_left_finger"/>
      <axis xyz="-1 0 0"/>
      <limit effort="130" lower="-0.05" upper="0.025" velocity="0.15"/>
    </joint>

    <!-- Robotiq: right finger -->
    <link name="robotiq_hande_right_finger">
      <inertial>
        <origin rpy="0 0 0" xyz="-0.02262 0.00759 0.00738"/>
        <mass value="0.03804"/>
        <inertia ixx="13567E-9" ixy="1849E-9" ixz="3622E-9" iyy="15784E-9" iyz="3616E-9" izz="7478E-9"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/finger_2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur3cranfield_gazebo)/meshes/robotiqhande/finger_2.dae"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="robotiq_hande_right_finger">
      <material>Gazebo/Grey</material>
    </gazebo>

    <joint name="robotiq_hande_right_finger_joint" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0.099"/>
      <parent link="robotiq_hande_base_link"/>
      <child link="robotiq_hande_right_finger"/>
      <axis xyz="1 0 0"/>
      <limit effort="130" lower="-0.05" upper="0.025" velocity="0.15"/>
    </joint>

    <!-- SMALL CUBE FOR GRIPPER PLUGIN -->

    <link name="EE_robotiq_hande">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.00001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
      <visual>
        <geometry>
          <box size= "0.001 0.001 0.001" />
        </geometry>
      </visual>
    </link>

    <xacro:unless value="${bringup}">
      <joint name="EE_robotiq_hande_joint" type="prismatic" >
        <parent link="robotiq_hande_base_link" />
        <child link="EE_robotiq_hande" />
        <limit effort="10000" lower="0.0" upper="0.0" velocity="0.0"/>
        <axis xyz="1 0 0" />
        <origin xyz="0.0 0.0 0.135" rpy="0 0 0"/>
      </joint>

      <!-- LOAD LinkPose Gazebo (ROS2) PLUGIN: -->
      <gazebo>
        <plugin name="ros2_linkpose_plugin" filename="libros2_linkpose_plugin.so" >
          <link>EE_robotiq_hande</link>
        </plugin>
      </gazebo>
    </xacro:unless>

    <xacro:if value="${bringup}">
      <joint name="EE_robotiq_hande_joint" type="fixed" >
        <parent link="robotiq_hande_base_link" />
        <child link="EE_robotiq_hande" />
        <origin xyz="0.0 0.0 0.135" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <!-- Disable Gazebo collisions -->
    <xacro:unless value="${bringup}">
      <gazebo reference="robotiq_hande_base_link">
        <selfCollide>false</selfCollide>
      </gazebo>
      <gazebo reference="robotiq_hande_left_finger">
        <selfCollide>false</selfCollide>
      </gazebo>
      <gazebo reference="robotiq_hande_right_finger">
        <selfCollide>false</selfCollide>
      </gazebo>
    </xacro:unless>

    <!-- ========================== -->
    <!-- PART 2: ROS 2 TRANSMISSION -->
    <!-- ========================== -->

    <xacro:unless value="${bringup}">

      <transmission name="robotiq_hande_left_finger_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="robotiq_hande_left_finger_joint">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="robotiq_hande_left_finger_motor">
          <mechanicalReduction>1</mechanicalReduction>
        </actuator>
      </transmission>

      <transmission name="robotiq_hande_right_finger_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="robotiq_hande_right_finger_joint">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="robotiq_hande_right_finger_motor">
          <mechanicalReduction>1</mechanicalReduction>
        </actuator>
      </transmission>

    </xacro:unless>

  </xacro:macro>

  <!-- ===================== -->
  <!-- PART 3: ROS 2 CONTROL -->
  <!-- ===================== -->

  <xacro:macro name="robotiq_hande_ros2control" params="">

    <joint name="robotiq_hande_left_finger_joint">
      <command_interface name="position">
        <param name="min">-0.05</param>
        <param name="max">0.025</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-0.15</param>
        <param name="max">0.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="robotiq_hande_right_finger_joint">
      <command_interface name="position">
        <param name="min">-0.05</param>
        <param name="max">0.025</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-0.15</param>
        <param name="max">0.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="EE_robotiq_hande_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </xacro:macro>

</robot>